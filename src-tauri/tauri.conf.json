{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArgonGUI-PLCDriver",
  "version": "1.0.0",
  "identifier": "com.argongui.plcdriver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArgonGUI Industrial PLC Driver 測試與壓力驗證工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage", "deb"],
    "icon": []
  }
}
